# Copy this file to .env and fill in real values. Never commit .env itself.

# Postgres connection string.
# Local example:      postgres://postgres:postgres@localhost:5432/engconnect
# Render/Railway/Neon give you this string directly in their dashboard.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/engconnect

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# Port the API listens on (most hosts set this for you automatically).
PORT=4000

# Exact URL of your deployed frontend, e.g. https://engconnect.yourcollege.app
# Used for CORS — only this origin will be allowed to call the API.
# Use http://localhost:5500 (or wherever you serve the html file) while testing locally.
CORS_ORIGIN=http://localhost:5500
